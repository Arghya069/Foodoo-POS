# Copy to backend/.env and replace the placeholders. Never commit backend/.env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use a dedicated non-superuser PostgreSQL account.
# URL-encode special characters in the password if necessary.
DATABASE_URL=postgresql://foodoo_pos:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/foodoo_pos_restaurant_001
