FOODOO_FIRESTORE_PROJECT=invoicing-predev
FOODOO_FIRESTORE_DATABASE=(default)
FOODOO_SESSION_SECRET=replace-with-a-long-random-secret
FOODOO_COOKIE_SECURE=false
FOODOO_ALLOWED_ORIGINS=http://localhost:5173
FOODOO_BOOTSTRAP_RESTAURANT=one-more
# Meta WhatsApp Cloud API: set these using Secret Manager for deployment.
# WHATSAPP_ACCESS_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_TEMPLATE_NAME=approved_document_header_template_name
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_GRAPH_VERSION=v26.0
# Optional comma-separated body placeholders: customer_name,receipt_number,total,token_number,restaurant_name
# WHATSAPP_TEMPLATE_BODY_FIELDS=
